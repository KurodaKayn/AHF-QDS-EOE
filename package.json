{
  "name": "ahf-qds-eoe",
  "version": "1.3.2",
  "private": true,
  "description": "A Multi-Plantform Application for Quiz Practice.",
  "author": "KurodaKayn",
  "scripts": {
    "dev": "dotenv -- next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "format": "oxfmt --write .",
    "test": "vitest run",
    "test:unit": "vitest run src/utils/__tests__",
    "test:regression": "vitest run src/regression/__tests__",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit --pretty false",
    "ci:verify": "pnpm lint && pnpm test:regression && pnpm test:unit && pnpm typecheck",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:tauri": "pnpm build && tauri build",
    "prepare": "husky"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-progress": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.8",
    "@radix-ui/react-select": "^2.2.4",
    "@radix-ui/react-slot": "^1.2.2",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-dialog": "^2.5.0",
    "@tauri-apps/plugin-fs": "^2.4.5",
    "@tauri-apps/plugin-sql": "^2.3.1",
    "@types/uuid": "^11.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "i18next": "^25.7.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.509.0",
    "nanoid": "^5.1.9",
    "next": "15.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^16.5.1",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-spinners": "^0.17.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.2.0",
    "tesseract.js": "^7.0.0",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.5",
    "zustand": "^5.0.4"
